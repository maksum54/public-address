<Window x:Class="PublicAddress.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Public Address Calculation" Width="1180" Height="740" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12.5" Background="#F5F7FA">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#1565C0"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#D0D7E2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="#1565C0"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock" x:Key="Lbl">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
            <Setter Property="Foreground" Value="#37474F"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="MinWidth" Value="160"/>
        </Style>
        <Style TargetType="Button" x:Key="Primary">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="Secondary">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1565C0"/>
            <Setter Property="BorderBrush" Value="#1565C0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E3E8EF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFD"/>
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7E2"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E8EEF6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="BorderBrush" Value="#D0D7E2"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="Border" x:Key="Formula">
            <Setter Property="Background" Value="#FFF8E1"/>
            <Setter Property="BorderBrush" Value="#FFE082"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Accent}" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="HeaderIcon" Width="32" Height="32" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Public Address Calculation" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Sistem 100 V line  ·  satuan meter" Foreground="#BBDEFB"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#ECEFF1" Padding="12,5">
            <TextBlock x:Name="StatusText" Text="Siap." Foreground="#455A64"/>
        </Border>

        <TabControl Margin="10" Padding="10">
            <!-- ================= CEILING ================= -->
            <TabItem Header="  Ceiling Speaker  " FontWeight="SemiBold">
                <DockPanel TextElement.FontWeight="Normal">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <GroupBox Header="Speaker">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Model"/>
                                <ComboBox x:Name="CeilSpeaker" Grid.Column="1" SelectionChanged="CeilInputChanged"/>
                                <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Text="Family type"/>
                                <ComboBox x:Name="CeilFamily" Grid.Row="1" Grid.Column="1" MinWidth="240"/>
                                <TextBlock x:Name="CeilSpec" Grid.Row="2" Grid.ColumnSpan="2" Foreground="#607D8B" Margin="0,4,0,0"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Desain">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Metode spacing"/>
                                <ComboBox x:Name="CeilMethod" Grid.Column="1" SelectionChanged="CeilInputChanged">
                                    <ComboBoxItem Content="Luas ÷ coverage area (standar)" Tag="CoverageArea"/>
                                    <ComboBoxItem Content="Edge to Center (Biamp) - rapat" Tag="EdgeToCenter"/>
                                    <ComboBoxItem Content="Partial Overlap (Biamp) - kotak" Tag="MinOverlapSquare"/>
                                    <ComboBoxItem Content="Partial Overlap (Biamp) - hex" Tag="MinOverlapHex"/>
                                    <ComboBoxItem Content="Edge to Edge (Biamp) - paling sedikit" Tag="NoOverlap"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Text="Tinggi telinga (m)"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="CeilEar" Text="1.2"/>
                                    <TextBlock Style="{StaticResource Lbl}" Margin="8,0" Text="duduk 1.2 / berdiri 1.5" Foreground="#90A4AE"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Lbl}" Grid.Row="2" Text="Level"/>
                                <ComboBox x:Name="CeilLevel" Grid.Row="2" Grid.Column="1" SelectionChanged="CeilLevelChanged"/>
                                <TextBlock Style="{StaticResource Lbl}" Grid.Row="3" Text="Cakupan ruangan"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton x:Name="CeilCentered" Content="Terpusat" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" Click="CeilCoverage_Click"
                                                 ToolTip="Lingkaran coverage muat di dalam ruang (jumlah = floor). Sama dengan Biamp 'Terpusat'."/>
                                    <RadioButton x:Name="CeilFull" Content="Penuh" VerticalAlignment="Center" Click="CeilCoverage_Click"
                                                 ToolTip="Coverage sampai ke dinding (jumlah = ceil)."/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Target SPL">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Noise default (dBA)"/>
                                <TextBox x:Name="CeilNoise" Grid.Column="1" Text="50"/>
                                <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Text="Margin di atas noise (dB)"/>
                                <TextBox x:Name="CeilMargin" Grid.Row="1" Grid.Column="1" Text="10"/>
                                <TextBlock Style="{StaticResource Lbl}" Grid.Row="2" Text="Tinggi plafon (m)" FontWeight="SemiBold"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="CeilBulkH" Text="3.0" Width="50"/>
                                    <Button Style="{StaticResource Secondary}" Content="Terapkan" Padding="8,2"
                                            ToolTip="Isi tinggi plafon &amp; noise ke semua baris yang dicentang" Click="CeilBulkHeight_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Secondary}" Content="Export CSV" Click="CeilExport_Click"/>
                            <Button Style="{StaticResource Secondary}" Content="Hitung" Click="CeilCalc_Click"/>
                            <Button Style="{StaticResource Primary}" Content="Tempatkan Speaker di Model" Click="CeilPlace_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="Pilih semua" VerticalAlignment="Center" Click="CeilSelectAll_Click" x:Name="CeilAll" IsChecked="True"/>
                            <TextBlock x:Name="CeilSummary" Margin="16,0" FontWeight="SemiBold" Foreground="#1565C0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Formula}">
                        <TextBlock TextWrapping="Wrap" Foreground="#5D4037">
                            <Run FontWeight="SemiBold" Text="Rumus: "/>
                            <Run Text="h = plafon − telinga  ·  r = h·tan(sudut/2)  ·  coverage = π·r²  ·  Jumlah = ceil(luas lantai ÷ coverage)  |  metode grid: s = r (edge-center), r√2 (kotak), r√3 (hex), 2r (no overlap)  ·  SPL = Sens + 10·log(Tap) − 20·log(h)  ·  Tap = tap terkecil dengan SPL ≥ noise + margin"/>
                        </TextBlock>
                    </Border>

                    <DataGrid x:Name="CeilGrid" Margin="0,10,0,0" CellEditEnding="CeilGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="32"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="No." Binding="{Binding Number}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="Nama Space" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Luas (m²)" Binding="{Binding Area, StringFormat=0.0}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="Plafon (m) ✎" Binding="{Binding CeilingH, StringFormat=0.00}" Width="80"/>
                            <DataGridTextColumn Header="Noise (dBA) ✎" Binding="{Binding Noise, StringFormat=0}" Width="85"/>
                            <DataGridTextColumn Header="h (m)" Binding="{Binding H, StringFormat=0.00}" IsReadOnly="True" Width="55"/>
                            <DataGridTextColumn Header="r (m)" Binding="{Binding R, StringFormat=0.00}" IsReadOnly="True" Width="55"/>
                            <DataGridTextColumn Header="Coverage (m²)" Binding="{Binding CoverageM2, StringFormat=0.0}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="Spacing (m)" Binding="{Binding S, StringFormat=0.00}" IsReadOnly="True" Width="75"/>
                            <DataGridTextColumn Header="Jumlah" Binding="{Binding Count}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="Tap (W)" Binding="{Binding Tap}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="SPL (dB)" Binding="{Binding Spl, StringFormat=0.0}" IsReadOnly="True" Width="65"/>
                            <DataGridTextColumn Header="Total (W)" Binding="{Binding TotalW}" IsReadOnly="True" Width="65"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="110">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="True">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ================= HORN ================= -->
            <TabItem Header="  Horn Speaker  " FontWeight="SemiBold">
                <Grid TextElement.FontWeight="Normal">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <GroupBox Header="Speaker">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Model"/>
                                <ComboBox x:Name="HornSpeaker" Grid.Column="1" SelectionChanged="HornSpeaker_Changed"/>
                                <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Text="Tap 100 V (W)"/>
                                <ComboBox x:Name="HornTap" Grid.Row="1" Grid.Column="1" MinWidth="80" HorizontalAlignment="Left" SelectionChanged="HornTapChanged"/>
                                <TextBlock Style="{StaticResource Lbl}" Grid.Row="2" Text="Family (face-based)"/>
                                <ComboBox x:Name="HornFamily" Grid.Row="2" Grid.Column="1" MinWidth="230"/>
                                <TextBlock x:Name="HornSpec" Grid.Row="3" Grid.ColumnSpan="2" Foreground="#607D8B" Margin="0,4,0,0"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Pemasangan" Margin="0,10,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Tinggi pasang dari level (m)"/>
                                <TextBox x:Name="HornMount" Grid.Column="1" Text="4.0" TextChanged="HornInputChanged"/>
                                <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Text="Tinggi telinga (m)"/>
                                <TextBox x:Name="HornEar" Grid.Row="1" Grid.Column="1" Text="1.5" TextChanged="HornInputChanged"/>
                                <TextBlock Style="{StaticResource Lbl}" Grid.Row="2" Text="Level radius (dB)"/>
                                <TextBox x:Name="HornDb" Grid.Row="2" Grid.Column="1" Text="99, 94, 90" Width="120" TextChanged="HornInputChanged"/>
                                <TextBlock Style="{StaticResource Lbl}" Grid.Row="3" Text="Jumlah per dinding"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="HornCount" Text="0" Width="50"/>
                                    <TextBlock Style="{StaticResource Lbl}" Margin="8,0" Text="0 = otomatis" Foreground="#90A4AE"/>
                                </StackPanel>
                                <CheckBox x:Name="HornDraw" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,6,0,0" IsChecked="True"
                                          Content="Gambar radius dB di Floor Plan aktif"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Rekomendasi dari Space" Margin="0,10,10,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="HornSpace" MinWidth="200" DisplayMemberPath="Label"/>
                                    <Button Style="{StaticResource Secondary}" Content="Klik di Model" Padding="8,2" Click="HornPickSpace_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Style="{StaticResource Secondary}" Margin="0" Content="Hitung Rekomendasi" Click="HornRecommend_Click"/>
                                    <Button Style="{StaticResource Secondary}" Content="Pakai" x:Name="HornApply" IsEnabled="False" Click="HornApply_Click"
                                            ToolTip="Isi tap &amp; jumlah per dinding dari rekomendasi"/>
                                </StackPanel>
                                <TextBlock x:Name="HornRecText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#37474F"/>
                            </StackPanel>
                        </GroupBox>
                        <Button Style="{StaticResource Primary}" Margin="0,14,10,0" HorizontalAlignment="Stretch"
                                Content="Pilih Face Dinding &amp; Tempatkan Horn" Click="HornPlace_Click"/>
                        <TextBlock Margin="0,6,10,0" TextWrapping="Wrap" Foreground="#78909C"
                                   Text="Klik sisi dinding yang menghadap area (bisa beberapa), lalu tekan Finish di Options Bar. Horn dibagi rata sepanjang dinding."/>
                    </StackPanel></ScrollViewer>

                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="Radius SPL (on-axis, free field)" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,6"/>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Formula}">
                            <TextBlock TextWrapping="Wrap" Foreground="#5D4037">
                                <Run FontWeight="SemiBold" Text="Rumus: "/>
                                <Run Text="d = 10^((Sens + 10·log(Tap) − SPL) / 20)  ·  jangkauan horizontal = √(d² − (tinggi pasang − telinga)²)  ·  lebar sebaran = 2·jangkauan·tan(H/2)"/>
                            </TextBlock>
                        </Border>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="HornHeadline" FontSize="15" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <DataGrid x:Name="HornGrid" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SPL (dB)" Binding="{Binding Db, StringFormat=0}" Width="80"/>
                                <DataGridTextColumn Header="Jarak miring d (m)" Binding="{Binding Slant, StringFormat=0.0}" Width="*"/>
                                <DataGridTextColumn Header="Jangkauan horizontal (m)" Binding="{Binding Reach, StringFormat=0.0}" Width="*"/>
                                <DataGridTextColumn Header="Lebar sebaran H (m)" Binding="{Binding Width, StringFormat=0.0}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ================= REKAP ================= -->
            <TabItem Header="  Rekap &amp; Amplifier  " FontWeight="SemiBold">
                <DockPanel TextElement.FontWeight="Normal">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Lbl}" Text="Headroom amplifier"/>
                        <TextBox x:Name="RecapHeadroom" Text="1.25" Width="50"/>
                        <Button Style="{StaticResource Secondary}" Content="Refresh dari Model" Click="RecapRefresh_Click"/>
                        <Button Style="{StaticResource Secondary}" Content="Export CSV" Click="RecapExport_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#78909C" TextWrapping="Wrap"
                               Text="Hanya speaker yang ditempatkan add-in ini (Comments diawali 'PA|'). Amplifier = total watt × headroom, dibulatkan ke ukuran standar 60/120/240/360/480/600/900/1200/2400 W."/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <DataGrid x:Name="RecapDetail" IsReadOnly="True" Margin="0,0,10,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Level / Zona" Binding="{Binding Level}" Width="*"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                                <DataGridTextColumn Header="Tap (W)" Binding="{Binding Tap}" Width="70"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="50"/>
                                <DataGridTextColumn Header="Total (W)" Binding="{Binding TotalW}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="RecapZone" Grid.Column="1" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Level / Zona" Binding="{Binding Level}" Width="*"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="50"/>
                                <DataGridTextColumn Header="Total (W)" Binding="{Binding TotalW}" Width="75"/>
                                <DataGridTextColumn Header="Amplifier (W)" Binding="{Binding Amp}" Width="95" FontWeight="SemiBold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
